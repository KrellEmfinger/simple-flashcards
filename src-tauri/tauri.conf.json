{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simple Flashcards",
  "version": "1.0.0",
  "identifier": "io.github.krellemfinger.simpleflashcards",
  "build": {
    "frontendDist": "../app-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Simple Flashcards",
        "width": 1100,
        "height": 860,
        "minWidth": 380,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Study flashcards offline",
    "longDescription": "Simple Flashcards: decks, study piles, typed and timed answers, deck packs, and cards made from your notes. Works offline.",
    "copyright": "Copyright (c) 2026 Krell Emfinger",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    }
  }
}
